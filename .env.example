# Turso (libSQL). En local puedes usar un fichero: file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# NextAuth (genera el secreto con: npx auth secret)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (login + Google Calendar). Scope: calendar.events
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Secreto del cron (Vercel lo envía como "Authorization: Bearer <CRON_SECRET>").
# Genera uno con: openssl rand -base64 32
CRON_SECRET=
